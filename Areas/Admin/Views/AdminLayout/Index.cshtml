@{
    Layout = null;

    // Breadcrumb için route bilgileri (örn: Admin / Deneyimler / DeneyimListesi)
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var pageTitle = ViewData["Title"]?.ToString() ?? action;

    // Aktif menü kontrolü
    string Active(string ctrl) =>
        string.Equals(controller, ctrl, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@pageTitle | Portfolyo Admin</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --navy-950: #060B17;
            --navy-900: #0B1325;
            --navy-850: #0F1A32;
            --navy-800: #142342;
            --navy-750: #1B2E54;
            --navy-700: #233B6A;
            --navy-accent: #2563EB;
            --navy-accent-hover: #1D4ED8;

            --steel-ice: #60A5FA;
            --steel-ice-soft: rgba(96, 165, 250, 0.12);
            --steel-ice-border: rgba(96, 165, 250, 0.24);
            --steel-light: #93C5FD;
            --accent-glow: rgba(37, 99, 235, 0.25);

            --sidebar-bg: #070D1A;
            --sidebar-surface: #0E182F;
            --sidebar-active: rgba(37, 99, 235, 0.18);
            --sidebar-text: #94A3B8;
            --sidebar-active-text: #FFFFFF;
            --sidebar-border: rgba(148, 163, 184, 0.12);

            --bg-main: #060B17;
            --card-bg: #0F1A32;
            --card-bg-elevated: #142342;
            --text-primary: #F8FAFC;
            --text-secondary: #94A3B8;
            --text-muted: #64748B;

            --primary-accent: #2563EB;
            --primary-accent-hover: #1D4ED8;
            --border-color: rgba(148, 163, 184, 0.14);
            --border-color-hover: rgba(96, 165, 250, 0.35);

            --radius-sm: 8px;
            --radius-md: 12px;
            --radius-lg: 16px;
            --radius-xl: 20px;
            --shadow-subtle: 0 4px 20px rgba(0, 0, 0, 0.45);
            --shadow-card: 0 10px 28px -6px rgba(0, 0, 0, 0.6);
            --shadow-dropdown: 0 14px 34px rgba(0, 0, 0, 0.7);
            --sidebar-width: 260px;
            --transition-base: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: var(--bg-main);
            background-image: 
                radial-gradient(1100px circle at 50% -120px, rgba(29, 78, 216, 0.14), transparent 70%),
                radial-gradient(850px circle at 90% 40%, rgba(15, 26, 50, 0.5), transparent 60%);
            background-attachment: fixed;
            color: var(--text-primary);
            margin: 0;
            min-height: 100vh;
            overflow-x: hidden;
            font-size: 0.925rem;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Plus Jakarta Sans', sans-serif;
            color: var(--text-primary);
            letter-spacing: -0.02em;
        }

        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        ::-webkit-scrollbar-track {
            background: var(--navy-950);
        }

        ::-webkit-scrollbar-thumb {
            background: var(--navy-750);
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: var(--steel-ice);
        }

        #sidebar-wrapper {
            width: var(--sidebar-width);
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            background-color: var(--sidebar-bg);
            border-right: 1px solid var(--sidebar-border);
            display: flex;
            flex-direction: column;
            z-index: 1040;
            box-shadow: 4px 0 30px rgba(0, 0, 0, 0.5);
            transition: transform 0.3s ease;
        }

        .sidebar-brand {
            padding: 22px 20px 18px;
            border-bottom: 1px solid var(--sidebar-border);
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .brand-mark {
            width: 38px;
            height: 38px;
            background: linear-gradient(135deg, #1E40AF 0%, #3B82F6 100%);
            color: #fff;
            font-weight: 800;
            font-size: 1.2rem;
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 14px rgba(37, 99, 235, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.15);
        }

        .sidebar-nav {
            flex: 1;
            overflow-y: auto;
            padding: 10px 14px 16px;
        }

        .nav-group-title {
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--text-muted);
            margin: 18px 10px 8px;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 14px;
            margin-bottom: 3px;
            border-radius: var(--radius-md);
            color: var(--sidebar-text);
            text-decoration: none;
            font-size: 0.88rem;
            font-weight: 500;
            transition: var(--transition-base);
            position: relative;
            border: 1px solid transparent;
        }

        .sidebar-link i {
            font-size: 1.05rem;
            color: var(--text-muted);
            transition: var(--transition-base);
        }

        .sidebar-link:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.04);
            border-color: rgba(255, 255, 255, 0.06);
        }

        .sidebar-link:hover i {
            color: var(--steel-ice);
        }

        .sidebar-link.active {
            background-color: var(--sidebar-active);
            color: #fff;
            font-weight: 600;
            border-color: var(--steel-ice-border);
        }

        .sidebar-link.active i {
            color: var(--steel-ice);
        }

        .sidebar-link.active::before {
            content: '';
            position: absolute;
            left: -10px;
            top: 8px;
            bottom: 8px;
            width: 4px;
            border-radius: 4px;
            background: var(--steel-ice);
            box-shadow: 0 0 10px var(--steel-ice);
        }

        .sidebar-user {
            margin: 0 14px 14px;
            padding: 12px 14px;
            background: var(--sidebar-surface);
            border: 1px solid var(--sidebar-border);
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .user-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: rgba(37, 99, 235, 0.2);
            border: 1px solid var(--steel-ice-border);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--steel-light);
            font-weight: 700;
            font-size: 0.8rem;
            flex-shrink: 0;
        }

        #main-content-wrapper {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            min-width: 0;
            transition: margin-left 0.3s ease;
        }

        .admin-navbar {
            height: 68px;
            background: rgba(6, 11, 23, 0.85);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--border-color);
            position: sticky;
            top: 0;
            z-index: 1020;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 28px;
            gap: 16px;
        }

        .nav-icon-btn {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            border: 1px solid var(--border-color);
            background: var(--navy-850);
            color: var(--text-secondary);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            transition: var(--transition-base);
            text-decoration: none;
        }

        .nav-icon-btn:hover {
            background: var(--navy-800);
            color: #fff;
            border-color: var(--steel-ice);
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
        }

        .nav-user-btn {
            display: flex;
            align-items: center;
            gap: 10px;
            border: none;
            background: transparent;
            padding: 4px;
            border-radius: 30px;
            color: var(--text-primary);
        }

        .dropdown-menu {
            background: var(--navy-900);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-dropdown);
            padding: 8px;
        }

        .dropdown-item {
            color: var(--text-secondary);
            border-radius: 8px;
            padding: 8px 12px;
            font-size: 0.86rem;
            display: flex;
            align-items: center;
            gap: 10px;
            transition: var(--transition-base);
        }

        .dropdown-item:hover {
            background: rgba(37, 99, 235, 0.16);
            color: #fff;
        }

        .dropdown-divider {
            border-color: var(--border-color);
        }

        .page-header {
            padding: 22px 28px 0;
        }

        .page-header h1 {
            font-size: 1.4rem;
            font-weight: 700;
            color: #fff;
            margin: 0 0 4px;
            letter-spacing: -0.02em;
        }

        .breadcrumb {
            margin: 0;
            font-size: 0.82rem;
        }

        .breadcrumb-item a {
            color: var(--text-secondary);
            text-decoration: none;
            transition: var(--transition-base);
        }

        .breadcrumb-item a:hover {
            color: var(--steel-ice);
        }

        .breadcrumb-item.active {
            color: var(--steel-ice);
            font-weight: 600;
        }

        .breadcrumb-item + .breadcrumb-item::before {
            content: "/";
            color: var(--text-muted);
        }

        .main-body-container {
            flex: 1;
            padding: 20px 28px 28px;
            min-width: 0;
        }

        .main-body-container .table-responsive,
        .main-body-container table {
            max-width: 100%;
        }

        .card {
            background-color: var(--card-bg) !important;
            border: 1px solid var(--border-color) !important;
            color: var(--text-primary) !important;
            border-radius: var(--radius-lg) !important;
            box-shadow: var(--shadow-card) !important;
        }

        .card-header {
            background-color: var(--navy-800) !important;
            border-bottom: 1px solid var(--border-color) !important;
            color: #fff !important;
        }

        .card-body {
            color: var(--text-primary) !important;
        }

        .card-footer {
            background-color: var(--navy-900) !important;
            border-top: 1px solid var(--border-color) !important;
        }

        .table {
            --bs-table-bg: transparent;
            --bs-table-color: var(--text-primary);
            color: var(--text-primary) !important;
            border-color: var(--border-color) !important;
            margin-bottom: 0;
        }

        .table th, .table thead th, .table-light th {
            background-color: var(--navy-800) !important;
            color: var(--steel-light) !important;
            border-color: var(--border-color) !important;
            font-weight: 600;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 12px 16px;
        }

        .table td, .table tbody td {
            background-color: transparent !important;
            color: var(--text-primary) !important;
            border-color: rgba(255, 255, 255, 0.06) !important;
            padding: 14px 16px;
            font-size: 0.88rem;
            vertical-align: middle;
        }

        .table-hover tbody tr:hover td {
            background-color: rgba(37, 99, 235, 0.08) !important;
        }

        .table-bordered {
            border: 1px solid var(--border-color) !important;
        }

        .form-control, .form-select {
            background-color: var(--navy-900) !important;
            border: 1px solid var(--border-color) !important;
            color: #fff !important;
            border-radius: 10px !important;
            padding: 9px 13px;
            font-size: 0.88rem;
            transition: var(--transition-base);
        }

        .form-control:focus, .form-select:focus {
            background-color: var(--navy-900) !important;
            border-color: var(--steel-ice) !important;
            color: #fff !important;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.25) !important;
        }

        .form-control::placeholder {
            color: var(--text-muted);
        }

        .form-label {
            color: #E2E8F0;
            font-size: 0.84rem;
            font-weight: 600;
            margin-bottom: 6px;
        }

        .form-card {
            background: var(--card-bg) !important;
            border: 1px solid var(--border-color) !important;
            border-radius: var(--radius-lg) !important;
            box-shadow: var(--shadow-card) !important;
        }

        .form-card-header {
            padding: 20px 26px;
            background: var(--navy-800) !important;
            border-bottom: 1px solid var(--border-color) !important;
            display: flex;
            align-items: center;
            gap: 14px;
            border-radius: var(--radius-lg) var(--radius-lg) 0 0;
        }

        .form-card-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: rgba(37, 99, 235, 0.15) !important;
            color: var(--steel-ice) !important;
            border: 1px solid var(--steel-ice-border) !important;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            flex-shrink: 0;
        }

        .form-card-body {
            padding: 26px;
            background: var(--card-bg);
        }

        .form-card-footer {
            padding: 16px 26px;
            border-top: 1px solid var(--border-color);
            background: var(--navy-900) !important;
            border-radius: 0 0 var(--radius-lg) var(--radius-lg);
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        .status-box {
            border: 1px solid var(--border-color) !important;
            border-radius: 10px;
            padding: 12px 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            background: var(--navy-900) !important;
            color: var(--text-primary);
        }

        .btn-primary, .btn-accent {
            background: linear-gradient(135deg, #1D4ED8 0%, #2563EB 100%) !important;
            border: 1px solid rgba(96, 165, 250, 0.35) !important;
            color: #fff !important;
            font-weight: 600;
            border-radius: 10px;
            padding: 8px 18px;
            box-shadow: 0 4px 14px rgba(29, 78, 216, 0.35);
            transition: var(--transition-base);
        }

        .btn-primary:hover, .btn-accent:hover {
            background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%) !important;
            border-color: rgba(147, 197, 253, 0.6) !important;
            box-shadow: 0 6px 20px rgba(37, 99, 235, 0.45);
            transform: translateY(-1px);
            color: #fff !important;
        }

        .btn-outline-danger {
            border-color: rgba(239, 68, 68, 0.4);
            color: #F87171;
            background: rgba(239, 68, 68, 0.08);
        }

        .btn-outline-danger:hover {
            background: #DC2626;
            border-color: #DC2626;
            color: #fff;
        }

        .btn-outline-success {
            border-color: rgba(34, 197, 94, 0.4);
            color: #4ADE80;
            background: rgba(34, 197, 94, 0.08);
        }

        .btn-outline-success:hover {
            background: #16A34A;
            border-color: #16A34A;
            color: #fff;
        }

        .btn-outline-secondary {
            border-color: var(--border-color);
            color: var(--text-secondary);
            background: rgba(255, 255, 255, 0.04);
        }

        .btn-outline-secondary:hover {
            border-color: var(--steel-ice);
            color: #fff;
            background: rgba(37, 99, 235, 0.12);
        }

        .badge.bg-success-subtle, .badge.text-success {
            background: rgba(34, 197, 94, 0.14) !important;
            color: #4ADE80 !important;
            border: 1px solid rgba(74, 222, 128, 0.25) !important;
        }

        .badge.bg-secondary-subtle, .badge.text-secondary {
            background: rgba(148, 163, 184, 0.14) !important;
            color: #CBD5E1 !important;
            border: 1px solid rgba(148, 163, 184, 0.25) !important;
        }

        .badge.bg-light {
            background: var(--navy-800) !important;
            color: var(--steel-light) !important;
            border: 1px solid var(--border-color) !important;
        }

        .text-dark {
            color: #F8FAFC !important;
        }

        .text-muted {
            color: #94A3B8 !important;
        }

        .bg-white {
            background-color: var(--card-bg) !important;
            border-color: var(--border-color) !important;
        }

        .bg-light {
            background-color: var(--navy-900) !important;
            color: #E2E8F0 !important;
            border-color: var(--border-color) !important;
        }

        .admin-footer {
            border-top: 1px solid var(--border-color);
            background: #040812;
            padding: 16px 28px;
            font-size: 0.8rem;
            color: var(--text-muted);
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 8px;
        }

        .admin-footer a {
            color: var(--steel-ice);
            text-decoration: none;
            transition: var(--transition-base);
        }

        .admin-footer a:hover {
            color: #fff;
        }

        .sidebar-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(6, 11, 23, 0.7);
            z-index: 1035;
        }

        @@media (max-width: 991.98px) {
            #sidebar-wrapper {
                transform: translateX(-100%);
            }

            body.sidebar-open #sidebar-wrapper {
                transform: translateX(0);
            }

            body.sidebar-open .sidebar-overlay {
                display: block;
            }

            #main-content-wrapper {
                margin-left: 0;
            }

            .admin-navbar, .page-header, .main-body-container, .admin-footer {
                padding-left: 16px;
                padding-right: 16px;
            }
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <!-- ==================== SIDEBAR ==================== -->
    <aside id="sidebar-wrapper">
        <a href="/Admin" class="sidebar-brand">
            <div class="brand-mark">P</div>
            <div>
                <div class="fw-bold text-white lh-1" style="font-family: 'Plus Jakarta Sans';">Poyraz.</div>
                <small class="text-white-50" style="font-size: 0.72rem;">Portfolio Admin</small>
            </div>
        </a>

        <nav class="sidebar-nav">
            <div class="nav-group-title">Genel</div>
            <a href="/Admin/Dashboard/Index" class="sidebar-link @Active("Dashboard")">
                <i class="bi bi-speedometer2"></i><span>Dashboard</span>
            </a>

            <div class="nav-group-title">İçerik</div>
            <a href="/Admin/About/Index" class="sidebar-link @Active("About")">
                <i class="bi bi-person"></i><span>Hakkımda</span>
            </a>
            <a href="/Admin/Education/Index" class="sidebar-link @Active("Education")">
                <i class="bi bi-mortarboard"></i><span>Eğitim</span>
            </a>
            <a href="/Admin/Experience/ExperienceList" class="sidebar-link @Active("Experience")">
                <i class="bi bi-briefcase"></i><span>Deneyimler</span>
            </a>
            <a href="/Admin/Skill/Index" class="sidebar-link @Active("Skill")">
                <i class="bi bi-code-slash"></i><span>Yetenekler</span>
            </a>
            <a href="/Admin/Project/Index" class="sidebar-link @Active("Project")">
                <i class="bi bi-grid"></i><span>Projeler</span>
            </a>

            <div class="nav-group-title">İletişim & Sistem</div>
            <a href="/Admin/Message/MessageList" class="sidebar-link @Active("Message") @Active("Contact")">
                <i class="bi bi-envelope"></i><span>İletişim & Mesajlar</span>
            </a>
            <a href="/Admin/Setting/Index" class="sidebar-link @Active("Setting")">
                <i class="bi bi-gear"></i><span>Ayarlar</span>
            </a>
        </nav>

        <div class="sidebar-user">
            <div class="user-avatar">MY</div>
            <div class="overflow-hidden">
                <div class="fw-semibold text-white text-truncate" style="font-size: 0.83rem;">Murat Yücedağ</div>
                <div style="font-size: 0.7rem; color: #B3BFDF;">Yönetici</div>
            </div>
        </div>
    </aside>

    <div class="sidebar-overlay" onclick="toggleSidebar()"></div>

    <!-- ==================== MAIN ==================== -->
    <div id="main-content-wrapper">

        <!-- NAVBAR -->
        <header class="admin-navbar">
            <div class="d-flex align-items-center gap-3">
                <button type="button" class="nav-icon-btn d-lg-none" onclick="toggleSidebar()" aria-label="Menü">
                    <i class="bi bi-list"></i>
                </button>
                <span class="fw-semibold d-none d-sm-inline" style="font-family: 'Plus Jakarta Sans';">Yönetim Paneli</span>
            </div>

            <div class="d-flex align-items-center gap-2">
                <a href="/" target="_blank" class="nav-icon-btn" title="Siteyi Görüntüle">
                    <i class="bi bi-box-arrow-up-right"></i>
                </a>
                <a href="/Admin/Message/MessageList" class="nav-icon-btn" title="Mesajlar">
                    <i class="bi bi-envelope"></i>
                </a>

                <div class="dropdown">
                    <button class="nav-user-btn" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="user-avatar">MY</div>
                        <span class="fw-semibold d-none d-md-inline" style="font-size: 0.85rem;">Murat Yücedağ</span>
                        <i class="bi bi-chevron-down small text-secondary d-none d-md-inline"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="/Admin/Profile/Index"><i class="bi bi-person-circle"></i> Profilim</a></li>
                        <li><a class="dropdown-item" href="/Admin/Setting/Index"><i class="bi bi-gear"></i> Ayarlar</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" href="/Login/Logout"><i class="bi bi-box-arrow-right"></i> Çıkış Yap</a></li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- BREADCRUMB / URL -->
        <div class="page-header">
            <h1>@pageTitle</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    @if (!string.IsNullOrEmpty(area))
                    {
                        <li class="breadcrumb-item"><a href="/@area"><i class="bi bi-house-door me-1"></i>@area</a></li>
                    }
                    @if (!string.IsNullOrEmpty(controller))
                    {
                        <li class="breadcrumb-item"><a href="@(string.IsNullOrEmpty(area) ? "" : "/" + area)/@controller">@controller</a></li>
                    }
                    @if (!string.IsNullOrEmpty(action))
                    {
                        <li class="breadcrumb-item active" aria-current="page">@action</li>
                    }
                </ol>
            </nav>
        </div>

        <!-- CONTENT -->
        <main class="main-body-container">
            @RenderBody()
        </main>

        <!-- FOOTER -->
        <footer class="admin-footer">
            <span>© @DateTime.Now.Year Poyraz. Portfolio Admin — Tüm hakları saklıdır.</span>
            <span>
                <a href="/" target="_blank">Siteyi Görüntüle</a>
                <span class="mx-2">•</span>
                <span>v1.0</span>
            </span>
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleSidebar() {
            document.body.classList.toggle("sidebar-open");
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
