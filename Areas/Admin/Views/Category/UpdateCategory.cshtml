@model MY_Academy_Portfolio2.Entities.Category

@{
    ViewData["Title"] = "Kategori Güncelle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<form method="post" asp-area="Admin" asp-action="UpdateCategory">
    <input type="hidden" asp-for="CategoryId" />

    <div class="container-fluid p-4">
        <div class="card shadow-sm border-0 rounded-4 p-4" style="max-width: 650px;">
            <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                <div class="form-card-icon">
                    <i class="bi bi-pencil-square"></i>
                </div>
                <div>
                    <h5 class="fw-bold mb-0">Kategori Düzenle</h5>
                    <span class="text-secondary small">Kategori adını güncelleyin.</span>
                </div>
            </div>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

            <div class="mb-4">
                <label asp-for="CategoryName" class="form-label">Kategori Adı *</label>
                <input type="text" asp-for="CategoryName" class="form-control" />
                <span asp-validation-for="CategoryName" class="text-danger small"></span>
            </div>

            <div class="pt-2 border-top d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-check-lg me-1"></i> Değişiklikleri Kaydet
                </button>
                <a href="/Admin/Category/Index" class="btn btn-outline-secondary px-4">Vazgeç</a>
            </div>
        </div>
    </div>
</form>
