@model MY_Academy_Portfolio2.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard - Yönetim Özeti";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";

    int totalMsg = Model.TotalMessages;
    int readMsg = Model.ReadMessages;
    int unreadMsg = Model.UnreadMessages;
    int readPercent = totalMsg > 0 ? (int)Math.Round(readMsg * 100.0 / totalMsg) : 0;
}

<style>
    .dash-stat-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
        gap: 16px;
        margin-bottom: 24px;
    }

    .dash-stat-card {
        background: var(--card-bg, #0F1A32);
        border: 1px solid var(--border-color, rgba(148, 163, 184, 0.12));
        border-radius: 16px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 16px;
        transition: transform 0.2s ease, border-color 0.2s ease;
    }

    .dash-stat-card:hover {
        transform: translateY(-2px);
        border-color: var(--steel-ice, #60A5FA);
    }

    .stat-icon-wrap {
        width: 50px;
        height: 50px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        flex-shrink: 0;
    }

    .stat-num {
        font-size: 1.75rem;
        font-weight: 800;
        color: #fff;
        line-height: 1.1;
        margin-bottom: 2px;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .stat-title {
        font-size: 0.8rem;
        color: var(--text-secondary, #94A3B8);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 600;
        margin: 0;
    }

    .dash-panel {
        background: var(--card-bg, #0F1A32);
        border: 1px solid var(--border-color, rgba(148, 163, 184, 0.12));
        border-radius: 16px;
        padding: 22px;
        height: 100%;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
    }

    .dash-panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
        padding-bottom: 12px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .dash-panel-title {
        font-size: 1rem;
        font-weight: 700;
        color: #fff;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .dash-quick-btn {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 18px;
        background: var(--navy-900, #0B1325);
        border: 1px solid var(--border-color, rgba(148, 163, 184, 0.12));
        border-radius: 12px;
        color: #fff;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9rem;
        transition: all 0.2s ease;
    }

    .dash-quick-btn:hover {
        background: rgba(37, 99, 235, 0.15);
        border-color: var(--steel-ice, #60A5FA);
        color: #fff;
        transform: translateY(-2px);
    }
</style>

<div class="container-fluid p-4">
    <!-- Header with Quick Action Shortcut -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h3 class="fw-bold text-white mb-1">Yönetim Özeti (Dashboard)</h3>
            <p class="text-secondary small mb-0">Portfolyo istatistikleri, son mesajlar, son projeler ve kategori dağılımı.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/" target="_blank" class="btn btn-outline-secondary">
                <i class="bi bi-box-arrow-up-right me-1"></i> Portfolyoyu Aç
            </a>
            <a href="/Admin/Project/CreateProject" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i> Yeni Proje Ekle
            </a>
        </div>
    </div>

    <!-- 05 | İstatistik Kartları -->
    <div class="dash-stat-grid">
        <!-- Toplam Proje -->
        <div class="dash-stat-card">
            <div class="stat-icon-wrap" style="background: rgba(37, 99, 235, 0.18); color: #60A5FA;">
                <i class="bi bi-grid-fill"></i>
            </div>
            <div>
                <div class="stat-num">@Model.TotalProjects</div>
                <p class="stat-title">Toplam Proje</p>
                <small class="text-secondary" style="font-size: 0.72rem;">Aktif: @Model.ActiveProjects</small>
            </div>
        </div>

        <!-- Yetenek Sayısı -->
        <div class="dash-stat-card">
            <div class="stat-icon-wrap" style="background: rgba(168, 85, 247, 0.18); color: #C084FC;">
                <i class="bi bi-code-slash"></i>
            </div>
            <div>
                <div class="stat-num">@Model.TotalSkills</div>
                <p class="stat-title">Yetenekler</p>
                <small class="text-secondary" style="font-size: 0.72rem;">Teknoloji & Beceri</small>
            </div>
        </div>

        <!-- Deneyimler -->
        <div class="dash-stat-card">
            <div class="stat-icon-wrap" style="background: rgba(34, 197, 94, 0.18); color: #4ADE80;">
                <i class="bi bi-briefcase-fill"></i>
            </div>
            <div>
                <div class="stat-num">@Model.TotalExperiences</div>
                <p class="stat-title">Deneyim</p>
                <small class="text-secondary" style="font-size: 0.72rem;">Aktif: @Model.ActiveExperiences</small>
            </div>
        </div>

        <!-- Eğitim -->
        <div class="dash-stat-card">
            <div class="stat-icon-wrap" style="background: rgba(14, 165, 233, 0.18); color: #38BDF8;">
                <i class="bi bi-mortarboard-fill"></i>
            </div>
            <div>
                <div class="stat-num">@Model.TotalEducations</div>
                <p class="stat-title">Eğitim</p>
                <small class="text-secondary" style="font-size: 0.72rem;">Akademik Kayıt</small>
            </div>
        </div>

        <!-- Toplam Mesaj -->
        <div class="dash-stat-card">
            <div class="stat-icon-wrap" style="background: rgba(245, 158, 11, 0.18); color: #FBBF24;">
                <i class="bi bi-envelope-fill"></i>
            </div>
            <div>
                <div class="stat-num">@Model.TotalMessages</div>
                <p class="stat-title">Toplam Mesaj</p>
                <small class="text-secondary" style="font-size: 0.72rem;">İletişim Formu</small>
            </div>
        </div>

        <!-- Okunmamış Mesaj -->
        <div class="dash-stat-card">
            <div class="stat-icon-wrap" style="background: rgba(239, 68, 68, 0.18); color: #F87171;">
                <i class="bi bi-envelope-exclamation-fill"></i>
            </div>
            <div>
                <div class="stat-num">@Model.UnreadMessages</div>
                <p class="stat-title">Okunmamış</p>
                <small class="text-secondary" style="font-size: 0.72rem;">Bekleyen Yanıtlar</small>
            </div>
        </div>
    </div>

    <!-- Quick Actions Row -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <a href="/Admin/Project/CreateProject" class="dash-quick-btn">
                <i class="bi bi-plus-circle text-primary fs-5"></i>
                <div>
                    <div>Yeni Proje Ekle</div>
                    <small class="text-secondary fw-normal">Görsel ve kategori ile</small>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a href="/Admin/Message/MessageList" class="dash-quick-btn">
                <i class="bi bi-inbox text-warning fs-5"></i>
                <div>
                    <div>Mesajları Görüntüle</div>
                    <small class="text-secondary fw-normal">@Model.UnreadMessages okunmamış mesaj var</small>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a href="/Admin/Category/Index" class="dash-quick-btn">
                <i class="bi bi-tags text-success fs-5"></i>
                <div>
                    <div>Kategori Yönetimi</div>
                    <small class="text-secondary fw-normal">@Model.TotalCategories aktif kategori</small>
                </div>
            </a>
        </div>
    </div>

    <!-- Main Content: Son 5 Mesaj & Son 3 Proje & Kategori Özeti -->
    <div class="row g-4">
        <!-- Son 5 Mesaj -->
        <div class="col-lg-7">
            <div class="dash-panel">
                <div class="dash-panel-header">
                    <h5 class="dash-panel-title">
                        <i class="bi bi-chat-left-dots text-primary"></i> Son 5 Mesaj
                    </h5>
                    <a href="/Admin/Message/MessageList" class="btn btn-sm btn-outline-secondary">Tümünü Gör</a>
                </div>

                @if (!Model.RecentMessages.Any())
                {
                    <div class="text-center py-4 text-secondary">
                        <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                        Henüz gelen bir mesaj bulunmuyor.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Gönderen</th>
                                    <th>Konu</th>
                                    <th>Tarih</th>
                                    <th>Durum</th>
                                    <th>İşlem</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var msg in Model.RecentMessages)
                                {
                                    <tr>
                                        <td class="fw-semibold text-white">@msg.NameSurname</td>
                                        <td class="small text-truncate" style="max-width: 180px;">@msg.Subject</td>
                                        <td class="small text-secondary">@msg.SendDate.ToString("dd MMM HH:mm")</td>
                                        <td>
                                            @if (msg.IsRead)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1 small">Okundu</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-2 py-1 small">Yeni</span>
                                            }
                                        </td>
                                        <td>
                                            <a href="/Admin/Message/MessageDetail/@msg.MessageId" class="btn btn-xs btn-outline-primary" style="padding: 2px 8px; font-size: 0.78rem;">
                                                <i class="bi bi-eye"></i> İncele
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- Kategori Özeti -->
        <div class="col-lg-5">
            <div class="dash-panel">
                <div class="dash-panel-header">
                    <h5 class="dash-panel-title">
                        <i class="bi bi-pie-chart text-success"></i> Kategori Özeti
                    </h5>
                    <a href="/Admin/Category/Index" class="btn btn-sm btn-outline-secondary">Kategoriler</a>
                </div>

                @if (!Model.CategorySummaries.Any())
                {
                    <div class="text-center py-4 text-secondary">
                        <i class="bi bi-folder-x fs-2 d-block mb-2"></i>
                        Kategori verisi bulunamadı.
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var cat in Model.CategorySummaries)
                        {
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-semibold text-white small">@cat.CategoryName</span>
                                    <span class="small text-secondary">@cat.ProjectCount Proje (%@cat.Percentage)</span>
                                </div>
                                <div class="progress" style="height: 7px; background: var(--navy-900, #0B1325); border-radius: 99px;">
                                    <div class="progress-bar" style="width: @cat.Percentage%; background: linear-gradient(90deg, #1D4ED8, #38BDF8); border-radius: 99px;"></div>
                                </div>
                            </div>
                        }
                    </div>
                }

                <hr class="my-4 border-secondary opacity-25" />

                <!-- Mesaj Okunma Oranı Donut / Progress Bar -->
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small fw-semibold text-secondary">Mesaj Okunma Oranı</span>
                        <span class="small fw-bold text-success">%@readPercent</span>
                    </div>
                    <div class="progress" style="height: 8px; background: rgba(239, 68, 68, 0.2); border-radius: 99px;">
                        <div class="progress-bar bg-success" style="width: @readPercent%; border-radius: 99px;"></div>
                    </div>
                    <div class="d-flex justify-content-between small text-secondary mt-1">
                        <span>Okunmuş: @readMsg</span>
                        <span>Okunmamış: @unreadMsg</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Son 3 Proje -->
        <div class="col-12">
            <div class="dash-panel">
                <div class="dash-panel-header">
                    <h5 class="dash-panel-title">
                        <i class="bi bi-kanban text-info"></i> Son 3 Proje
                    </h5>
                    <a href="/Admin/Project/Index" class="btn btn-sm btn-outline-secondary">Tüm Projeler</a>
                </div>

                <div class="row g-3">
                    @if (!Model.RecentProjects.Any())
                    {
                        <div class="col-12 text-center py-4 text-secondary">
                            Henüz proje eklenmemiş.
                        </div>
                    }
                    else
                    {
                        @foreach (var p in Model.RecentProjects)
                        {
                            <div class="col-md-4">
                                <div class="p-3 rounded-4 h-100 d-flex flex-column" style="background: var(--navy-900, #0B1325); border: 1px solid var(--border-color, rgba(148, 163, 184, 0.12));">
                                    <div class="d-flex gap-3 align-items-center mb-3">
                                        <img src="@p.CoverImageUrl" alt="@p.Title" style="width: 52px; height: 52px; object-fit: cover; border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.1);" />
                                        <div class="overflow-hidden">
                                            <h6 class="fw-bold text-white mb-0 text-truncate">@p.Title</h6>
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill small mt-1">
                                                @(p.Category?.CategoryName ?? "Genel")
                                            </span>
                                        </div>
                                    </div>
                                    <p class="text-secondary small mb-3 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                        @p.Description
                                    </p>
                                    <div class="d-flex justify-content-between align-items-center pt-2 border-top border-secondary border-opacity-10">
                                        <span class="badge bg-success-subtle text-success">Aktif</span>
                                        <a href="/Admin/Project/UpdateProject/@p.ProjectId" class="btn btn-sm btn-outline-success">
                                            <i class="bi bi-pencil me-1"></i> Düzenle
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>
