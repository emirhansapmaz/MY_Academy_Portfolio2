@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";

    int total = ViewBag.messageCount ?? 0;
    int readCount = ViewBag.messageReadByTrueCount ?? 0;
    int unreadCount = ViewBag.messageReadByFalseCount ?? 0;
    int readPercent = total > 0 ? (int)Math.Round(readCount * 100.0 / total) : 0;
    int unreadPercent = total > 0 ? 100 - readPercent : 0;
}

<style>
    .dash {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        color: var(--text-primary);
        padding: 8px 4px 24px;
    }

    .dash * {
        box-sizing: border-box;
    }

    .dash-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 24px;
    }

    .dash-header h1 {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 26px;
        font-weight: 700;
        color: #fff;
        margin: 0;
        letter-spacing: -0.02em;
    }

    .dash-header p {
        margin: 4px 0 0;
        color: var(--text-secondary);
        font-size: 14px;
    }

    .dash-btn {
        background: linear-gradient(135deg, #1D4ED8 0%, #2563EB 100%);
        color: #fff;
        border: 1px solid rgba(96, 165, 250, 0.35);
        padding: 9px 18px;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 4px 14px rgba(29, 78, 216, 0.35);
        transition: var(--transition-base);
    }

    .dash-btn:hover {
        background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
        border-color: rgba(147, 197, 253, 0.6);
        color: #fff;
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(37, 99, 235, 0.45);
    }

    .dash-grid {
        display: grid;
        gap: 20px;
    }

    .dash-stats {
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        margin-bottom: 20px;
    }

    .dash-main {
        grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
        margin-bottom: 20px;
    }

    .dash-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 22px;
        box-shadow: var(--shadow-card);
        transition: var(--transition-base);
    }

    .dash-card:hover {
        border-color: var(--steel-ice-border);
        transform: translateY(-2px);
    }

    .dash-card h3 {
        font-size: 16px;
        font-weight: 700;
        color: #fff;
        margin: 0 0 18px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        letter-spacing: -0.01em;
    }

    .dash-card h3 a {
        font-size: 13px;
        font-weight: 600;
        color: var(--steel-ice);
        text-decoration: none;
        transition: var(--transition-base);
    }

    .dash-card h3 a:hover {
        color: #fff;
    }

    .stat {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .stat-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        flex-shrink: 0;
    }

    .stat-label {
        font-size: 13px;
        color: var(--text-secondary);
        margin: 0;
        font-weight: 500;
    }

    .stat-value {
        font-size: 28px;
        font-weight: 800;
        margin: 2px 0 0;
        line-height: 1.1;
        color: #fff;
        letter-spacing: -0.02em;
    }

    .stat-sub {
        font-size: 12px;
        color: var(--text-muted);
        margin-top: 4px;
    }

    .bg-indigo {
        background: rgba(37, 99, 235, 0.16);
        color: var(--steel-ice);
        border: 1px solid var(--steel-ice-border);
    }

    .bg-green {
        background: rgba(34, 197, 94, 0.16);
        color: #4ADE80;
        border: 1px solid rgba(74, 222, 128, 0.25);
    }

    .bg-amber {
        background: rgba(245, 158, 11, 0.16);
        color: #FBBF24;
        border: 1px solid rgba(251, 191, 36, 0.25);
    }

    .bg-sky {
        background: rgba(56, 189, 248, 0.16);
        color: #38BDF8;
        border: 1px solid rgba(56, 189, 248, 0.25);
    }

    .progress-row {
        margin-bottom: 18px;
    }

    .progress-row:last-child {
        margin-bottom: 0;
    }

    .progress-top {
        display: flex;
        justify-content: space-between;
        font-size: 13px;
        margin-bottom: 6px;
        color: #E2E8F0;
        font-weight: 500;
    }

    .progress-top span:last-child {
        color: var(--text-secondary);
    }

    .progress-bar {
        height: 8px;
        background: var(--navy-900);
        border-radius: 99px;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .progress-fill {
        height: 100%;
        border-radius: 99px;
    }

    .fill-green {
        background: #10b981;
    }

    .fill-amber {
        background: #f59e0b;
    }

    .donut-wrap {
        display: flex;
        align-items: center;
        gap: 24px;
        flex-wrap: wrap;
    }

    .donut {
        width: 140px;
        height: 140px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border: 1px solid rgba(255, 255, 255, 0.06);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    }

    .donut-inner {
        width: 96px;
        height: 96px;
        background: var(--card-bg);
        border-radius: 50%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .donut-inner strong {
        font-size: 22px;
        font-weight: 800;
        color: #fff;
    }

    .donut-inner small {
        font-size: 11px;
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .legend {
        list-style: none;
        padding: 0;
        margin: 0;
        font-size: 13px;
        color: var(--text-secondary);
    }

    .legend li {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
        font-weight: 500;
    }

    .legend i {
        width: 10px;
        height: 10px;
        border-radius: 3px;
        display: inline-block;
    }

    .dash-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

    .dash-table th {
        text-align: left;
        font-weight: 600;
        color: var(--steel-light);
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: .06em;
        padding: 12px 14px;
        border-bottom: 1px solid var(--border-color);
        background: var(--navy-800);
    }

    .dash-table td {
        padding: 14px 12px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        color: var(--text-primary);
        vertical-align: middle;
    }

    .dash-table tr:last-child td {
        border-bottom: none;
    }

    .dash-table tr:hover td {
        background: rgba(37, 99, 235, 0.06);
    }

    .avatar {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: rgba(37, 99, 235, 0.2);
        border: 1px solid var(--steel-ice-border);
        color: var(--steel-light);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 12px;
        margin-right: 10px;
        flex-shrink: 0;
    }

    .name-cell {
        display: flex;
        align-items: center;
    }

    .muted {
        color: var(--text-muted);
        font-size: 13px;
    }

    .badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 99px;
        font-size: 11px;
        font-weight: 600;
    }

    .badge-read {
        background: rgba(34, 197, 94, 0.14);
        color: #4ADE80;
        border: 1px solid rgba(74, 222, 128, 0.25);
    }

    .badge-unread {
        background: rgba(245, 158, 11, 0.14);
        color: #FBBF24;
        border: 1px solid rgba(251, 191, 36, 0.25);
    }

    .table-scroll {
        overflow-x: auto;
    }

    .activity {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .activity li {
        display: flex;
        gap: 12px;
        padding: 12px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        font-size: 13px;
        color: var(--text-secondary);
    }

    .activity li b {
        color: #fff;
    }

    .activity li:last-child {
        border-bottom: none;
    }

    .dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        margin-top: 6px;
        flex-shrink: 0;
    }

    .activity .time {
        font-size: 11px;
        color: var(--text-muted);
        display: block;
        margin-top: 3px;
    }

    .quick-links {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .quick-links a {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 16px;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        color: var(--text-primary);
        background: var(--navy-900);
        text-decoration: none;
        font-size: 13px;
        font-weight: 500;
        transition: var(--transition-base);
    }

    .quick-links a:hover {
        border-color: var(--steel-ice);
        background: rgba(37, 99, 235, 0.12);
        color: #fff;
        transform: translateY(-1px);
    }
</style>

<div class="dash">

    <div class="dash-header">
        <div>
            <h1>Dashboard</h1>
            <p>Hoş geldiniz! Portfolyo sitenizin genel durumu aşağıda.</p>
        </div>
        <a href="/Admin/Message/MessageList" class="dash-btn">✉ Tüm Mesajlar</a>
    </div>

    <div class="dash-grid dash-stats">
        <div class="dash-card stat">
            <div class="stat-icon bg-indigo">✉</div>
            <div>
                <p class="stat-label">Toplam Mesaj</p>
                <p class="stat-value">@total</p>
                <div class="stat-sub">Tüm zamanlar</div>
            </div>
        </div>
        <div class="dash-card stat">
            <div class="stat-icon bg-green">✔</div>
            <div>
                <p class="stat-label">Okunmuş Mesaj</p>
                <p class="stat-value">@readCount</p>
                <div class="stat-sub">%@readPercent oranında</div>
            </div>
        </div>
        <div class="dash-card stat">
            <div class="stat-icon bg-amber">●</div>
            <div>
                <p class="stat-label">Okunmamış Mesaj</p>
                <p class="stat-value">@unreadCount</p>
                <div class="stat-sub">%@unreadPercent oranında</div>
            </div>
        </div>
        <div class="dash-card stat">
            <div class="stat-icon bg-sky">👁</div>
            <div>
                <p class="stat-label">Bu Ay Ziyaretçi</p>
                <p class="stat-value">1.284</p>
                <div class="stat-sub">Geçen aya göre +12%</div>
            </div>
        </div>
    </div>

    <div class="dash-grid dash-main">
        <div class="dash-card">
            <h3>Mesaj Durumu</h3>
            <div class="progress-row">
                <div class="progress-top"><span>Okunmuş</span><span>@readCount / @total</span></div>
                <div class="progress-bar"><div class="progress-fill fill-green" style="width:@(readPercent)%"></div></div>
            </div>
            <div class="progress-row">
                <div class="progress-top"><span>Okunmamış</span><span>@unreadCount / @total</span></div>
                <div class="progress-bar"><div class="progress-fill fill-amber" style="width:@(unreadPercent)%"></div></div>
            </div>
        </div>

        <div class="dash-card">
            <h3>Okunma Oranı</h3>
            <div class="donut-wrap">
                <div class="donut" style="background: conic-gradient(#10b981 0 @(readPercent)%, #f59e0b @(readPercent)% 100%);">
                    <div class="donut-inner">
                        <strong>%@readPercent</strong>
                        <small>okundu</small>
                    </div>
                </div>
                <ul class="legend">
                    <li><i style="background:#10b981"></i> Okunmuş (@readCount)</li>
                    <li><i style="background:#f59e0b"></i> Okunmamış (@unreadCount)</li>
                    <li><i style="background:#2563EB"></i> Toplam (@total)</li>
                </ul>
            </div>
        </div>
    </div>

    <div class="dash-card" style="margin-bottom:20px;">
        <h3>Son Mesajlar <a href="/Admin/Message/MessageList">Tümünü gör →</a></h3>
        <div class="table-scroll">
            <table class="dash-table">
                <thead>
                    <tr>
                        <th>Gönderen</th>
                        <th>Konu</th>
                        <th>Tarih</th>
                        <th>Durum</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><div class="name-cell"><span class="avatar">AY</span><div>Ahmet Yılmaz<div class="muted">ahmet@ornek.com</div></div></div></td>
                        <td>Proje teklifi hakkında</td>
                        <td class="muted">06.11.2026</td>
                        <td><span class="badge badge-unread">Okunmadı</span></td>
                    </tr>
                    <tr>
                        <td><div class="name-cell"><span class="avatar">EK</span><div>Elif Kaya<div class="muted">elif@ornek.com</div></div></div></td>
                        <td>Web sitesi tasarımı</td>
                        <td class="muted">05.11.2026</td>
                        <td><span class="badge badge-unread">Okunmadı</span></td>
                    </tr>
                    <tr>
                        <td><div class="name-cell"><span class="avatar">MD</span><div>Mehmet Demir<div class="muted">mehmet@ornek.com</div></div></div></td>
                        <td>İş birliği önerisi</td>
                        <td class="muted">03.11.2026</td>
                        <td><span class="badge badge-read">Okundu</span></td>
                    </tr>
                    <tr>
                        <td><div class="name-cell"><span class="avatar">ZÇ</span><div>Zeynep Çelik<div class="muted">zeynep@ornek.com</div></div></div></td>
                        <td>Teşekkür mesajı</td>
                        <td class="muted">01.11.2026</td>
                        <td><span class="badge badge-read">Okundu</span></td>
                    </tr>
                    <tr>
                        <td><div class="name-cell"><span class="avatar">BA</span><div>Burak Aksoy<div class="muted">burak@ornek.com</div></div></div></td>
                        <td>Freelance iş talebi</td>
                        <td class="muted">29.10.2026</td>
                        <td><span class="badge badge-read">Okundu</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="dash-grid dash-main">
        <div class="dash-card">
            <h3>Son Aktiviteler</h3>
            <ul class="activity">
                <li><span class="dot" style="background:#2563EB"></span><div>Yeni bir proje eklendi: <b>E-Ticaret Sitesi</b><span class="time">2 saat önce</span></div></li>
                <li><span class="dot" style="background:#10b981"></span><div>Hakkımda bölümü güncellendi<span class="time">Dün</span></div></li>
                <li><span class="dot" style="background:#f59e0b"></span><div>Yeni yetenek eklendi: <b>ASP.NET Core</b><span class="time">3 gün önce</span></div></li>
                <li><span class="dot" style="background:#38BDF8"></span><div>Deneyim bilgileri düzenlendi<span class="time">1 hafta önce</span></div></li>
            </ul>
        </div>

        <div class="dash-card">
            <h3>Hızlı Erişim</h3>
            <div class="quick-links">
                <a href="/Admin/Project/Index">📁 Projeler</a>
                <a href="/Admin/Skill/Index">🛠 Yetenekler</a>
                <a href="/Admin/Experience/ExperienceList">💼 Deneyimler</a>
                <a href="/Admin/Education/Index">🎓 Eğitim</a>
                <a href="/Admin/About/Index">👤 Hakkımda</a>
                <a href="/Admin/Message/MessageList">✉ Mesajlar</a>
            </div>
        </div>
    </div>

</div>