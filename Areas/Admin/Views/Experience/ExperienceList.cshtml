@model List<MY_Academy_Portfolio2.Entities.Experience>

@{
    ViewData["Title"] = "Deneyim Listesi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold mb-0">Deneyim Listesi</h4>
        <a href="/Admin/Experience/CreateExperience" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Yeni Deneyim Ekle
        </a>
    </div>
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Başlık</th>
                        <th>Alt Başlık</th>
                        <th>Tarih</th>
                        <th>Durum</th>
                        <th style="width: 110px; text-align: center;">Sil</th>
                        <th style="width: 110px; text-align: center;">Güncelle</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.ExperienceId</td>
                            <td>@item.Title</td>
                            <td>@item.SideTitle</td>
                            <td>@item.Duration</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">Pasif</span>
                                }
                            </td>
                            <td class="text-center">
                                <a href="/Admin/Experience/DeleteExperience/@item.ExperienceId" class="btn btn-sm btn-outline-danger btn-delete-confirm btn-action" data-item-title="@item.SideTitle">
                                    <i class="bi bi-trash"></i> Sil
                                </a>
                            </td>
                            <td class="text-center">
                                <a href="/Admin/Experience/UpdateExperience/@item.ExperienceId" class="btn btn-sm btn-outline-success btn-action">
                                    <i class="bi bi-pencil"></i> Güncelle
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
