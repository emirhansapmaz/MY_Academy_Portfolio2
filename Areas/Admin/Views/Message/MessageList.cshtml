@model List<MY_Academy_Portfolio2.Entities.Message>

@{
    ViewData["Title"] = "Mesaj Listesi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold mb-0">Gelen Mesajlar</h4>
        <span class="badge bg-light text-primary border px-3 py-2">Toplam: @Model.Count Mesaj</span>
    </div>
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Gönderici</th>
                        <th>Email</th>
                        <th>Konu</th>
                        <th>Tarih</th>
                        <th>Mesajı Aç</th>
                        <th>Sil</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.MessageId</td>
                            <td class="fw-semibold">@item.NameSurname</td>
                            <td>@item.Email</td>
                            <td>@item.Subject</td>
                            <td>@item.SendDate.ToString("dd MMM yyyy")</td>
                            <td><a href="/Admin/Message/MessageDetail/@item.MessageId" class="btn btn-sm btn-primary">Mesajı Aç</a></td>
                            <td><a href="/Admin/Message/DeleteMessage/@item.MessageId" class="btn btn-sm btn-outline-danger">Sil</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>