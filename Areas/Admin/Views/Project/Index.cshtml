@model List<MY_Academy_Portfolio2.Entities.Project>

@{
    ViewData["Title"] = "Proje Listesi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1">Projelerim</h4>
            <p class="text-secondary small mb-0">Portfolyo sitesinde listelenen ve SQL veritabanından çekilen projeleriniz.</p>
        </div>
        <a href="/Admin/Project/CreateProject" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Yeni Proje Ekle
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Görsel</th>
                        <th>Proje Başlığı</th>
                        <th>Kategori</th>
                        <th>Açıklama</th>
                        <th>GitHub</th>
                        <th>Sil</th>
                        <th>Güncelle</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.ProjectId</td>
                            <td>
                                <img src="@item.CoverImageUrl" alt="@item.Title" style="width: 64px; height: 40px; object-fit: cover; border-radius: 8px; border: 1px solid var(--border-color);" />
                            </td>
                            <td class="fw-semibold text-white">@item.Title</td>
                            <td>
                                <span class="badge bg-light text-primary border">
                                    @(item.Category?.CategoryName ?? "Genel")
                                </span>
                            </td>
                            <td class="text-secondary small" style="max-width: 250px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                @item.Description
                            </td>
                            <td>
                                <a href="@item.GithubUrl" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-github"></i>
                                </a>
                            </td>
                            <td>
                                <a href="/Admin/Project/DeleteProject/@item.ProjectId" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i> Sil
                                </a>
                            </td>
                            <td>
                                <a href="/Admin/Project/UpdateProject/@item.ProjectId" class="btn btn-sm btn-outline-success">
                                    <i class="bi bi-pencil"></i> Güncelle
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>