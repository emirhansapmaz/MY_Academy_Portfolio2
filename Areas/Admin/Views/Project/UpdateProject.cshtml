@model MY_Academy_Portfolio2.Entities.Project

@{
    ViewData["Title"] = "Proje Güncelle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<form method="post" asp-area="Admin" asp-action="UpdateProject" enctype="multipart/form-data">
    <input type="hidden" asp-for="ProjectId" />

    <div class="container-fluid p-4">
        <div class="card shadow-sm border-0 rounded-4 p-4">
            <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                <div class="form-card-icon">
                    <i class="bi bi-pencil-square"></i>
                </div>
                <div>
                    <h5 class="fw-bold mb-0">Projeyi Güncelle</h5>
                    <span class="text-secondary small">Projenin başlık, açıklama, kategori, dosya veya bağlantılarını düzenleyin.</span>
                </div>
            </div>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Title" class="form-label">Proje Başlığı *</label>
                    <input type="text" asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="CategoryId" class="form-label">Proje Kategorisi *</label>
                    <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                        <option value="">Kategori Seçiniz</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>

                <!-- Mevcut Görsel Önizleme & Yeni Dosya Yükleme -->
                <div class="col-md-6">
                    <label class="form-label">Yeni Görsel Yükle (Değiştirmek İsterseniz)</label>
                    <input type="file" name="imageFile" accept=".jpg,.jpeg,.png,.webp,.svg" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label asp-for="CoverImageUrl" class="form-label">Mevcut Görsel URL</label>
                    <div class="input-group">
                        <input type="text" asp-for="CoverImageUrl" class="form-control" />
                        @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
                        {
                            <span class="input-group-text bg-transparent border-secondary p-1">
                                <img src="@Model.CoverImageUrl" alt="Önizleme" style="height: 30px; border-radius: 4px;" />
                            </span>
                        }
                    </div>
                    <span asp-validation-for="CoverImageUrl" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="GithubUrl" class="form-label">GitHub URL *</label>
                    <input type="url" asp-for="GithubUrl" class="form-control" />
                    <span asp-validation-for="GithubUrl" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Description" class="form-label">Proje Açıklaması *</label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="col-12 mt-4 pt-2 border-top d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-lg me-1"></i> Değişiklikleri Kaydet
                    </button>
                    <a href="/Admin/Project/Index" class="btn btn-outline-secondary px-4">Vazgeç</a>
                </div>
            </div>
        </div>
    </div>
</form>
