<style>
    :root {
        --navy-950: #060B17;
        --navy-900: #0B1325;
        --navy-850: #0F1A32;
        --navy-800: #142342;
        --navy-750: #1B2E54;
        --navy-700: #233B6A;
        --navy-accent: #2563EB;
        --navy-accent-hover: #1D4ED8;

        --steel-ice: #60A5FA;
        --steel-ice-soft: rgba(96, 165, 250, 0.12);
        --steel-ice-border: rgba(96, 165, 250, 0.24);
        --steel-light: #93C5FD;
        --accent-glow: rgba(37, 99, 235, 0.25);

        --sidebar-bg: #070D1A;
        --sidebar-surface: #0E182F;
        --sidebar-active: rgba(37, 99, 235, 0.18);
        --sidebar-text: #94A3B8;
        --sidebar-active-text: #FFFFFF;
        --sidebar-border: rgba(148, 163, 184, 0.12);

        --bg-main: #060B17;
        --card-bg: #0F1A32;
        --card-bg-elevated: #142342;
        --text-primary: #F8FAFC;
        --text-secondary: #94A3B8;
        --text-muted: #64748B;

        --primary-accent: #2563EB;
        --primary-accent-hover: #1D4ED8;
        --border-color: rgba(148, 163, 184, 0.14);
        --border-color-hover: rgba(96, 165, 250, 0.35);

        --radius-sm: 8px;
        --radius-md: 12px;
        --radius-lg: 16px;
        --radius-xl: 20px;
        --shadow-subtle: 0 4px 20px rgba(0, 0, 0, 0.45);
        --shadow-card: 0 10px 28px -6px rgba(0, 0, 0, 0.6);
        --shadow-dropdown: 0 14px 34px rgba(0, 0, 0, 0.7);
        --sidebar-width: 260px;
        --transition-base: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    }

    * {
        box-sizing: border-box;
    }

    body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        background-color: var(--bg-main);
        background-image: 
            radial-gradient(1100px circle at 50% -120px, rgba(29, 78, 216, 0.14), transparent 70%),
            radial-gradient(850px circle at 90% 40%, rgba(15, 26, 50, 0.5), transparent 60%);
        background-attachment: fixed;
        color: var(--text-primary);
        margin: 0;
        min-height: 100vh;
        overflow-x: hidden;
        font-size: 0.925rem;
    }

    h1, h2, h3, h4, h5, h6, .font-heading {
        font-family: 'Plus Jakarta Sans', sans-serif;
        color: var(--text-primary);
        letter-spacing: -0.02em;
    }

    ::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }

    ::-webkit-scrollbar-track {
        background: var(--navy-950);
    }

    ::-webkit-scrollbar-thumb {
        background: var(--navy-750);
        border-radius: 4px;
    }

    ::-webkit-scrollbar-thumb:hover {
        background: var(--steel-ice);
    }

    #sidebar-wrapper {
        width: 260px;
        min-width: 260px;
        height: 100vh;
        position: fixed;
        top: 0;
        left: 0;
        background-color: var(--sidebar-bg);
        border-right: 1px solid var(--sidebar-border);
        display: flex;
        flex-direction: column;
        z-index: 1040;
        box-shadow: 4px 0 30px rgba(0, 0, 0, 0.5);
        transition: transform 0.3s ease;
    }

    .sidebar-brand {
        padding: 22px 20px 18px;
        border-bottom: 1px solid var(--sidebar-border);
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
    }

    .brand-mark {
        width: 38px;
        height: 38px;
        background: linear-gradient(135deg, #1E40AF 0%, #3B82F6 100%);
        color: #fff;
        font-weight: 800;
        font-size: 1.2rem;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 14px rgba(37, 99, 235, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.15);
    }

    .sidebar-user-card, .sidebar-user {
        margin: 0 14px 14px;
        padding: 12px 14px;
        background: var(--sidebar-surface);
        border: 1px solid var(--sidebar-border);
        border-radius: var(--radius-md);
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .sidebar-user-avatar, .user-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: rgba(37, 99, 235, 0.2);
        border: 1px solid var(--steel-ice-border);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--steel-light);
        font-weight: 700;
        font-size: 0.8rem;
        flex-shrink: 0;
    }

    .sidebar-nav, .sidebar-nav-scroll {
        flex: 1;
        overflow-y: auto;
        padding: 10px 14px 16px;
    }

    .nav-group-title {
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--text-muted);
        margin: 18px 10px 8px;
    }

    .sidebar-link {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 14px;
        margin-bottom: 3px;
        border-radius: var(--radius-md);
        color: var(--sidebar-text);
        text-decoration: none;
        font-size: 0.88rem;
        font-weight: 500;
        transition: var(--transition-base);
        position: relative;
        border: 1px solid transparent;
    }

    .sidebar-link i {
        font-size: 1.05rem;
        color: var(--text-muted);
        transition: var(--transition-base);
    }

    .sidebar-link:hover {
        color: #fff;
        background: rgba(255, 255, 255, 0.04);
        border-color: rgba(255, 255, 255, 0.06);
    }

    .sidebar-link:hover i {
        color: var(--steel-ice);
    }

    .sidebar-link.active {
        background-color: var(--sidebar-active);
        color: #fff;
        font-weight: 600;
        border-color: var(--steel-ice-border);
    }

    .sidebar-link.active i {
        color: var(--steel-ice);
    }

    .sidebar-link.active::before {
        content: '';
        position: absolute;
        left: -10px;
        top: 8px;
        bottom: 8px;
        width: 4px;
        border-radius: 4px;
        background: var(--steel-ice);
        box-shadow: 0 0 10px var(--steel-ice);
    }

    #main-content-wrapper {
        margin-left: var(--sidebar-width);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        min-width: 0;
        transition: margin-left 0.3s ease;
    }

    .admin-navbar {
        height: 68px;
        background: rgba(6, 11, 23, 0.85);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid var(--border-color);
        position: sticky;
        top: 0;
        z-index: 1020;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 28px;
        gap: 16px;
    }

    .nav-icon-btn, .sidebar-toggle-btn, .icon-action-btn {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        border: 1px solid var(--border-color);
        background: var(--navy-850);
        color: var(--text-secondary);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        transition: var(--transition-base);
        text-decoration: none;
    }

    .nav-icon-btn:hover, .sidebar-toggle-btn:hover, .icon-action-btn:hover {
        background: var(--navy-800);
        color: #fff;
        border-color: var(--steel-ice);
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
    }

    .nav-search-box {
        display: flex;
        align-items: center;
        gap: 8px;
        background: var(--navy-900);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        padding: 6px 14px;
        color: var(--text-secondary);
    }

    .nav-search-box input {
        background: transparent;
        border: none;
        color: #fff;
        font-size: 0.85rem;
        outline: none;
    }

    .nav-search-box input::placeholder {
        color: var(--text-muted);
    }

    .btn-quick-add {
        background: linear-gradient(135deg, #1D4ED8 0%, #2563EB 100%);
        border: 1px solid rgba(96, 165, 250, 0.35);
        color: #fff;
        font-size: 0.85rem;
        font-weight: 600;
        border-radius: 10px;
        padding: 7px 14px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: var(--transition-base);
    }

    .btn-quick-add:hover {
        background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
        border-color: rgba(147, 197, 253, 0.6);
        box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
        transform: translateY(-1px);
    }

    .nav-profile-pill {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 4px 10px;
        border-radius: 20px;
        background: var(--navy-850);
        border: 1px solid var(--border-color);
        cursor: pointer;
        color: var(--text-primary);
    }

    .nav-avatar-mini {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: rgba(37, 99, 235, 0.25);
        border: 1px solid var(--steel-ice-border);
        color: var(--steel-light);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.72rem;
        font-weight: 700;
    }

    .dropdown-menu {
        background: var(--navy-900);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-dropdown);
        padding: 8px;
    }

    .dropdown-item {
        color: var(--text-secondary);
        border-radius: 8px;
        padding: 8px 12px;
        font-size: 0.86rem;
        display: flex;
        align-items: center;
        gap: 10px;
        transition: var(--transition-base);
    }

    .dropdown-item:hover {
        background: rgba(37, 99, 235, 0.16);
        color: #fff;
    }

    .dropdown-divider {
        border-color: var(--border-color);
    }

    .page-header {
        padding: 22px 28px 0;
    }

    .page-header h1 {
        font-size: 1.4rem;
        font-weight: 700;
        color: #fff;
        margin: 0 0 4px;
        letter-spacing: -0.02em;
    }

    .breadcrumb {
        margin: 0;
        font-size: 0.82rem;
    }

    .breadcrumb-item a {
        color: var(--text-secondary);
        text-decoration: none;
        transition: var(--transition-base);
    }

    .breadcrumb-item a:hover {
        color: var(--steel-ice);
    }

    .breadcrumb-item.active {
        color: var(--steel-ice);
        font-weight: 600;
    }

    .breadcrumb-item + .breadcrumb-item::before {
        content: "/";
        color: var(--text-muted);
    }

    .main-body-container {
        flex: 1;
        padding: 20px 28px 28px;
        min-width: 0;
    }

    .card {
        background-color: var(--card-bg) !important;
        border: 1px solid var(--border-color) !important;
        color: var(--text-primary) !important;
        border-radius: var(--radius-lg) !important;
        box-shadow: var(--shadow-card) !important;
    }

    .card-header {
        background-color: var(--navy-800) !important;
        border-bottom: 1px solid var(--border-color) !important;
        color: #fff !important;
    }

    .card-body {
        color: var(--text-primary) !important;
    }

    .card-footer {
        background-color: var(--navy-900) !important;
        border-top: 1px solid var(--border-color) !important;
    }

    .table {
        --bs-table-bg: transparent;
        --bs-table-color: var(--text-primary);
        color: var(--text-primary) !important;
        border-color: var(--border-color) !important;
        margin-bottom: 0;
    }

    .table th, .table thead th, .table-light th {
        background-color: var(--navy-800) !important;
        color: var(--steel-light) !important;
        border-color: var(--border-color) !important;
        font-weight: 600;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 12px 16px;
    }

    .table td, .table tbody td {
        background-color: transparent !important;
        color: var(--text-primary) !important;
        border-color: rgba(255, 255, 255, 0.06) !important;
        padding: 14px 16px;
        font-size: 0.88rem;
        vertical-align: middle;
    }

    .table-hover tbody tr:hover td {
        background-color: rgba(37, 99, 235, 0.08) !important;
    }

    .table-bordered {
        border: 1px solid var(--border-color) !important;
    }

    .form-control, .form-select {
        background-color: var(--navy-900) !important;
        border: 1px solid var(--border-color) !important;
        color: #fff !important;
        border-radius: 10px !important;
        padding: 9px 13px;
        font-size: 0.88rem;
        transition: var(--transition-base);
    }

    .form-control:focus, .form-select:focus {
        background-color: var(--navy-900) !important;
        border-color: var(--steel-ice) !important;
        color: #fff !important;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.25) !important;
    }

    .form-control::placeholder {
        color: var(--text-muted);
    }

    .form-label {
        color: #E2E8F0;
        font-size: 0.84rem;
        font-weight: 600;
        margin-bottom: 6px;
    }

    .form-card {
        background: var(--card-bg) !important;
        border: 1px solid var(--border-color) !important;
        border-radius: var(--radius-lg) !important;
        box-shadow: var(--shadow-card) !important;
    }

    .form-card-header {
        padding: 20px 26px;
        background: var(--navy-800) !important;
        border-bottom: 1px solid var(--border-color) !important;
        display: flex;
        align-items: center;
        gap: 14px;
        border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    }

    .form-card-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: rgba(37, 99, 235, 0.15) !important;
        color: var(--steel-ice) !important;
        border: 1px solid var(--steel-ice-border) !important;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        flex-shrink: 0;
    }

    .form-card-body {
        padding: 26px;
        background: var(--card-bg);
    }

    .form-card-footer {
        padding: 16px 26px;
        border-top: 1px solid var(--border-color);
        background: var(--navy-900) !important;
        border-radius: 0 0 var(--radius-lg) var(--radius-lg);
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }

    .status-box {
        border: 1px solid var(--border-color) !important;
        border-radius: 10px;
        padding: 12px 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        background: var(--navy-900) !important;
        color: var(--text-primary);
    }

    .btn-primary, .btn-accent {
        background: linear-gradient(135deg, #1D4ED8 0%, #2563EB 100%) !important;
        border: 1px solid rgba(96, 165, 250, 0.35) !important;
        color: #fff !important;
        font-weight: 600;
        border-radius: 10px;
        padding: 8px 18px;
        box-shadow: 0 4px 14px rgba(29, 78, 216, 0.35);
        transition: var(--transition-base);
    }

    .btn-primary:hover, .btn-accent:hover {
        background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%) !important;
        border-color: rgba(147, 197, 253, 0.6) !important;
        box-shadow: 0 6px 20px rgba(37, 99, 235, 0.45);
        transform: translateY(-1px);
        color: #fff !important;
    }

    .btn-outline-danger {
        border-color: rgba(239, 68, 68, 0.4);
        color: #F87171;
        background: rgba(239, 68, 68, 0.08);
    }

    .btn-outline-danger:hover {
        background: #DC2626;
        border-color: #DC2626;
        color: #fff;
    }

    .btn-outline-success {
        border-color: rgba(34, 197, 94, 0.4);
        color: #4ADE80;
        background: rgba(34, 197, 94, 0.08);
    }

    .btn-outline-success:hover {
        background: #16A34A;
        border-color: #16A34A;
        color: #fff;
    }

    .btn-outline-secondary {
        border-color: var(--border-color);
        color: var(--text-secondary);
        background: rgba(255, 255, 255, 0.04);
    }

    .btn-outline-secondary:hover {
        border-color: var(--steel-ice);
        color: #fff;
        background: rgba(37, 99, 235, 0.12);
    }

    .badge.bg-success-subtle, .badge.text-success {
        background: rgba(34, 197, 94, 0.14) !important;
        color: #4ADE80 !important;
        border: 1px solid rgba(74, 222, 128, 0.25) !important;
    }

    .badge.bg-secondary-subtle, .badge.text-secondary {
        background: rgba(148, 163, 184, 0.14) !important;
        color: #CBD5E1 !important;
        border: 1px solid rgba(148, 163, 184, 0.25) !important;
    }

    .badge.bg-light {
        background: var(--navy-800) !important;
        color: var(--steel-light) !important;
        border: 1px solid var(--border-color) !important;
    }

    .text-dark {
        color: #F8FAFC !important;
    }

    .text-muted {
        color: #94A3B8 !important;
    }

    .bg-white {
        background-color: var(--card-bg) !important;
        border-color: var(--border-color) !important;
    }

    .bg-light {
        background-color: var(--navy-900) !important;
        color: #E2E8F0 !important;
        border-color: var(--border-color) !important;
    }

    .admin-footer {
        border-top: 1px solid var(--border-color);
        background: #040812;
        padding: 16px 28px;
        font-size: 0.8rem;
        color: var(--text-muted);
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 8px;
    }

    .admin-footer a {
        color: var(--steel-ice);
        text-decoration: none;
        transition: var(--transition-base);
    }

    .admin-footer a:hover {
        color: #fff;
    }

    .sidebar-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(6, 11, 23, 0.7);
        z-index: 1035;
    }

    @@media (max-width: 991.98px) {
        #sidebar-wrapper {
            transform: translateX(-100%);
        }

        body.sidebar-open #sidebar-wrapper {
            transform: translateX(0);
        }

        body.sidebar-open .sidebar-overlay {
            display: block;
        }

        #main-content-wrapper {
            margin-left: 0;
        }

        .admin-navbar, .page-header, .main-body-container, .admin-footer {
            padding-left: 16px;
            padding-right: 16px;
        }
    }
