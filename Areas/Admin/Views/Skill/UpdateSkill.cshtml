@model MY_Academy_Portfolio2.Entities.Skill

@{
    ViewData["Title"] = "Yetenek Güncelle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<form method="post" asp-area="Admin" asp-action="UpdateSkill">
    <input type="hidden" asp-for="SkillId" />

    <div class="container-fluid p-4">
        <div class="card shadow-sm border-0 rounded-4 p-4">
            <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                <div class="form-card-icon">
                    <i class="bi bi-pencil-square"></i>
                </div>
                <div>
                    <h5 class="fw-bold mb-0">Yetenek Bilgisini Güncelle</h5>
                    <span class="text-secondary small">Teknik yetkinliğin adını, kategorisini veya seviyesini güncelleyin.</span>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Yetenek / Teknoloji Adı *</label>
                    <input type="text" asp-for="Title" class="form-control" required />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Kategori *</label>
                    <input type="text" asp-for="Category" class="form-control" list="categoryList" required />
                    <datalist id="categoryList">
                        <option value="Backend Development" />
                        <option value="Frontend Development" />
                        <option value="Database Technologies" />
                        <option value="Tools & Practices" />
                        <option value="Software Architecture" />
                    </datalist>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Yetkinlik Seviyesi (% 0 - 100) *</label>
                    <input type="number" asp-for="Value" min="0" max="100" class="form-control" required />
                </div>

                <div class="col-12 mt-4 pt-2 border-top d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-lg me-1"></i> Değişiklikleri Kaydet
                    </button>
                    <a href="/Admin/Skill/Index" class="btn btn-outline-secondary px-4">Vazgeç</a>
                </div>
            </div>
        </div>
    </div>
</form>
