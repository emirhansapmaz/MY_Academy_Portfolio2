@model List<MY_Academy_Portfolio2.Entities.Project>

<!-- Portfolio Projects Section -->
<section id="projects">
    <div class="container">
        <div class="text-center mb-4 reveal-on-scroll">
            <span class="section-eyebrow">SEÇİLMİŞ ÇALIŞMALAR</span>
            <h2 class="section-title">Projelerim</h2>
            <p class="section-subtitle">Öğrendiklerimi gerçek ürünlere dönüştürdüğüm çalışmalar.</p>
        </div>

        <!-- 02 | Dinamik Kategori Filtre Butonları -->
        <div class="d-flex justify-content-center flex-wrap gap-2 mb-5 reveal-on-scroll" id="projectFilterGroup">
            <button class="filter-btn active" data-filter="all">Tümü</button>
            @if (ViewBag.Categories is List<MY_Academy_Portfolio2.Entities.Category> categories)
            {
                foreach (var cat in categories)
                {
                    <button class="filter-btn" data-filter="cat-@cat.CategoryId">@cat.CategoryName</button>
                }
            }
        </div>

        <!-- Project Cards Grid -->
        <div class="row g-4" id="projectGrid">
            @if (Model == null || !Model.Any())
            {
                <div class="col-12 text-center py-5 text-secondary">
                    <i class="bi bi-folder2-open fs-1 d-block mb-3"></i>
                    Henüz sergilenecek bir proje eklenmemiş.
                </div>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <div class="col-lg-4 col-md-6 project-item" data-category="cat-@item.CategoryId">
                        <div class="project-card reveal-on-scroll">

                            <!-- Project Image -->
                            <div class="project-thumb" style="width:100%; aspect-ratio:16/9; overflow:hidden;">
                                <img src="@item.CoverImageUrl"
                                     alt="@item.Title"
                                     style="width:100%; height:100%; object-fit:cover; display:block;"
                                     onerror="this.src='https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=800&auto=format&fit=crop&q=80'" />
                            </div>

                            <!-- Project Content -->
                            <div class="project-body">
                                <span class="project-category-badge">@(item.Category?.CategoryName ?? "Genel")</span>

                                <h3 class="project-title">@item.Title</h3>

                                <p class="project-desc">@item.Description</p>

                                <!-- Technologies -->
                                <div class="mb-3">
                                    <span class="tech-tag">ASP.NET Core</span>
                                    <span class="tech-tag">EF Core</span>
                                    <span class="tech-tag">SQL Server</span>
                                    <span class="tech-tag">Bootstrap</span>
                                </div>

                                <!-- Project Links -->
                                <div class="project-footer">
                                    <a href="@item.GithubUrl"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="project-link-btn">
                                        <i class="bi bi-github"></i> GitHub
                                    </a>

                                    <a href="@item.GithubUrl"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="project-link-btn text-primary">
                                        <i class="bi bi-box-arrow-up-right"></i> İncele
                                    </a>
                                </div>
                            </div>

                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>
